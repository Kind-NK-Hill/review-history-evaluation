--- Blank experimental target for thm_11_4; implementation belongs in the task pack.
+import Mathlib
+import ProbabilityTheory.chapter_09.def_9_1
+
+open MeasureTheory
+open ProbabilityTheory
+
+/-- Two real random variables are uncorrelated when their centered product has
+zero expectation.  This is intentionally stated by expanding the definition,
+so downstream proofs can use the cross-term directly. -/
+def Uncorrelated {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
+    (X Y : Ω → ℝ) : Prop :=
+  ∫ ω, (X ω - P[X]) * (Y ω - P[Y]) ∂P = 0
+
+/-- The covariance form is exactly the preceding expanded definition. -/
+theorem uncorrelated_iff_covariance_eq_zero
+    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (X Y : Ω → ℝ) :
+    Uncorrelated P X Y ↔ cov[X, Y; P] = 0 := by
+  rfl
+
+/-- Theorem 11.4: the variance of a finite sum of pairwise uncorrelated
+square-integrable random variables is the sum of their variances.
+
+The proof expands the covariance of the sum into the double sum of centered
+cross-products.  Every off-diagonal term is killed by `Uncorrelated`; no
+finite-sum variance theorem is used. -/
+theorem thm_11_4 {Ω ι : Type*} [MeasurableSpace Ω] (P : Measure Ω)
+    [IsProbabilityMeasure P] (s : Finset ι) (X : ι → Ω → ℝ)
+    (hX : ∀ i ∈ s, MemLp (X i) 2 P)
+    (huncorr : Set.Pairwise (↑s : Set ι) fun i j => Uncorrelated P (X i) (X j)) :
+    Var[fun ω => ∑ i ∈ s, X i ω; P] = ∑ i ∈ s, Var[X i; P] := by
+  classical
+  let T : Ω → ℝ := fun ω => ∑ i ∈ s, X i ω
+  have hT : MemLp T 2 P := by
+    dsimp [T]
+    convert memLp_finsetSum' s hX using 1
+    ext ω
+    simp
+  rw [← covariance_self hT.aemeasurable]
+  have hexpand :
+      cov[T, T; P] = ∑ i ∈ s, ∑ j ∈ s, cov[X i, X j; P] := by
+    simpa [T] using
+      (covariance_fun_sum_fun_sum' (μ := P) (s := s) (X := X)
+        (t := s) (Y := X) hX hX)
+  rw [hexpand]
+  refine Finset.sum_congr rfl fun i hi => ?_
+  rw [← covariance_self (hX i hi).aemeasurable]
+  refine Finset.sum_eq_single_of_mem i hi fun j hj hji => ?_
+  have hij : i ≠ j := Ne.symm hji
+  exact (uncorrelated_iff_covariance_eq_zero P (X i) (X j)).1
+    (huncorr hi hj hij)
--- a/ProbabilityTheory/chapter_11/thm_11_5.lean
