import ProbabilityTheory.chapter_13.def_13_7
import ProbabilityTheory.common_support.chapter13_stopping_support

open MeasureTheory
open scoped BigOperators ProbabilityTheory

noncomputable section

/-!
# Problem 13.9: innovations form martingale differences

The definitions follow the one-based indexing in the book. The innovation at
zero is explicitly zero, and the partial sum at time `n` contains precisely the
innovations numbered `1` through `n`.
-/

/-- The natural filtration generated by `X₁, ..., Xₙ`, with trivial time-zero
sigma-field. -/
@[reducible]
def prob_13_9_filtration {Ω : Type*} (X : ℕ → Ω → ℝ) :
    ℕ → MeasurableSpace Ω :=
  chapter13_oneIndexedNaturalFiltration X

/-- The innovation `Yₙ = Xₙ - E[Xₙ | Fₙ₋₁]` for `n ≥ 1`, and `Y₀ = 0`. -/
def prob_13_9_innovation {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) : ℕ → Ω → ℝ
  | 0 => 0
  | n + 1 => X (n + 1) - P[X (n + 1) | prob_13_9_filtration X n]

/-- `Sₙ = ∑_{k=1}^n Yₖ`, in particular `S₀ = 0`. -/
def prob_13_9_partialSum {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) (n : ℕ) : Ω → ℝ :=
  ∑ k ∈ Finset.range n, prob_13_9_innovation P X (k + 1)

@[simp]
theorem prob_13_9_innovation_zero {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) :
    prob_13_9_innovation P X 0 = 0 := rfl

@[simp]
theorem prob_13_9_innovation_succ {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) (n : ℕ) :
    prob_13_9_innovation P X (n + 1) =
      X (n + 1) - P[X (n + 1) | prob_13_9_filtration X n] := rfl

@[simp]
theorem prob_13_9_partialSum_zero {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) :
    prob_13_9_partialSum P X 0 = 0 := by
  simp [prob_13_9_partialSum]

theorem prob_13_9_partialSum_succ {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) (n : ℕ) :
    prob_13_9_partialSum P X (n + 1) =
      prob_13_9_partialSum P X n + prob_13_9_innovation P X (n + 1) := by
  funext ω
  simp only [prob_13_9_partialSum, Finset.sum_range_succ, Finset.sum_apply,
    Pi.add_apply, prob_13_9_innovation_succ]

/-- Every original observation is measurable at its own time in its natural
filtration. At time zero this uses the stipulated `X₀ = 0`. -/
theorem prob_13_9_observation_adapted {Ω : Type*} [MeasurableSpace Ω]
    (X : ℕ → Ω → ℝ) (hX0 : X 0 = 0) :
    def_13_6_adapted (prob_13_9_filtration X) X := by
  intro n
  cases n with
  | zero =>
      rw [hX0]
      exact measurable_const
  | succ n =>
      have hhist := chapter13_history_measurable_self X (n + 1)
      let i : Fin (n + 1) := ⟨n, Nat.lt_succ_self n⟩
      have hcoord : Measurable (fun v : Fin (n + 1) → ℝ => v i) :=
        measurable_pi_apply i
      convert hcoord.comp hhist using 1
      funext ω
      rfl

/-- Each innovation is integrable, derived only from integrability of the
corresponding original observation. -/
theorem prob_13_9_innovation_integrable {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ)
    (hXint : ∀ n, Integrable (X n) P) :
    ∀ n, Integrable (prob_13_9_innovation P X n) P := by
  intro n
  cases n with
  | zero => exact integrable_zero _ _ _
  | succ n => exact (hXint (n + 1)).sub integrable_condExp

/-- An innovation available at time `k` remains measurable at every later
 time `n`. -/
theorem prob_13_9_innovation_measurable_le {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) (hX0 : X 0 = 0)
    {k n : ℕ} (hkn : k ≤ n) :
    @Measurable Ω ℝ (prob_13_9_filtration X n) _
      (prob_13_9_innovation P X k) := by
  cases k with
  | zero =>
      simp only [prob_13_9_innovation_zero]
      exact measurable_const
  | succ k =>
      have hXk : @Measurable Ω ℝ (prob_13_9_filtration X (k + 1)) _ (X (k + 1)) :=
        prob_13_9_observation_adapted X hX0 (k + 1)
      have hXk' : @Measurable Ω ℝ (prob_13_9_filtration X n) _ (X (k + 1)) :=
        hXk.mono (chapter13_oneIndexedNaturalFiltration_mono X hkn) le_rfl
      have hce0 : @Measurable Ω ℝ (prob_13_9_filtration X k) _
          (P[X (k + 1) | prob_13_9_filtration X k]) :=
        stronglyMeasurable_condExp.measurable
      have hce : @Measurable Ω ℝ (prob_13_9_filtration X n) _
          (P[X (k + 1) | prob_13_9_filtration X k]) :=
        hce0.mono
          (chapter13_oneIndexedNaturalFiltration_mono X
            (Nat.le_of_succ_le hkn)) le_rfl
      exact hXk'.sub hce

/-- The innovation process is adapted to the natural filtration. -/
theorem prob_13_9_innovation_adapted {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) (hX0 : X 0 = 0) :
    def_13_6_adapted (prob_13_9_filtration X)
      (prob_13_9_innovation P X) := by
  intro n
  exact prob_13_9_innovation_measurable_le P X hX0 (le_refl n)

/-- Every innovation partial sum is integrable. -/
theorem prob_13_9_partialSum_integrable {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ)
    (hXint : ∀ n, Integrable (X n) P) :
    ∀ n, Integrable (prob_13_9_partialSum P X n) P := by
  intro n
  exact integrable_finsetSum' _ fun k _ =>
    prob_13_9_innovation_integrable P X hXint (k + 1)

/-- The partial-sum process is adapted to the natural filtration. -/
theorem prob_13_9_partialSum_adapted {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) (hX0 : X 0 = 0) :
    def_13_6_adapted (prob_13_9_filtration X)
      (prob_13_9_partialSum P X) := by
  intro n
  induction n with
  | zero =>
      rw [prob_13_9_partialSum_zero]
      exact measurable_const
  | succ n ih =>
      rw [prob_13_9_partialSum_succ]
      have ih' : @Measurable Ω ℝ (prob_13_9_filtration X (n + 1)) _
          (prob_13_9_partialSum P X n) :=
        ih.mono (chapter13_oneIndexedNaturalFiltration_mono X (Nat.le_succ n)) le_rfl
      exact ih'.add
        (prob_13_9_innovation_measurable_le P X hX0 (le_refl (n + 1)))

/-- The next innovation has conditional mean zero given the present natural
filtration. -/
theorem prob_13_9_innovation_condExp_zero {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (X : ℕ → Ω → ℝ) (hXmeas : ∀ n, Measurable (X n))
    (hXint : ∀ n, Integrable (X n) P) (n : ℕ) :
    P[prob_13_9_innovation P X (n + 1) | prob_13_9_filtration X n] =ᵐ[P]
      0 := by
  have hsub : prob_13_9_filtration X n ≤ (inferInstance : MeasurableSpace Ω) :=
    chapter13_oneIndexedNaturalFiltration_sub_ambient X hXmeas n
  have htower :
      P[P[X (n + 1) | prob_13_9_filtration X n] |
          prob_13_9_filtration X n] =ᵐ[P]
        P[X (n + 1) | prob_13_9_filtration X n] :=
    condExp_condExp_of_le le_rfl hsub
  change P[X (n + 1) - P[X (n + 1) | prob_13_9_filtration X n] |
      prob_13_9_filtration X n] =ᵐ[P] 0
  have hlin := condExp_sub (hXint (n + 1))
    (integrable_condExp : Integrable
      (P[X (n + 1) | prob_13_9_filtration X n]) P)
    (prob_13_9_filtration X n)
  filter_upwards [hlin, htower] with ω hlinω htowerω
  rw [hlinω]
  simp only [Pi.sub_apply, Pi.zero_apply]
  rw [htowerω, sub_self]

/-- Problem 13.9: the concrete innovation partial sums are a martingale for
 the natural filtration. All obligations are derived from the source assumptions. -/
theorem prob_13_9 {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (X : ℕ → Ω → ℝ) (hX0 : X 0 = 0)
    (hXmeas : ∀ n, 1 ≤ n → Measurable (X n))
    (hXint : ∀ n, 1 ≤ n → Integrable (X n) P) :
    def_13_7 P (prob_13_9_filtration X) (prob_13_9_partialSum P X) := by
  have hXmeas_all : ∀ n, Measurable (X n) := by
    intro n
    cases n with
    | zero =>
        rw [hX0]
        exact measurable_const
    | succ n =>
        exact hXmeas (n + 1) (Nat.succ_le_succ (Nat.zero_le n))
  have hXint_all : ∀ n, Integrable (X n) P := by
    intro n
    cases n with
    | zero =>
        rw [hX0]
        exact integrable_zero _ _ _
    | succ n =>
        exact hXint (n + 1) (Nat.succ_le_succ (Nat.zero_le n))
  refine ⟨chapter13_oneIndexedNaturalFiltration_isFiltration X hXmeas_all,
    prob_13_9_partialSum_integrable P X hXint_all,
    prob_13_9_partialSum_adapted P X hX0, ?_⟩
  intro n
  refine ⟨inferInstance,
    chapter13_oneIndexedNaturalFiltration_sub_ambient X hXmeas_all n,
    prob_13_9_partialSum_integrable P X hXint_all (n + 1), ?_⟩
  have hSn : StronglyMeasurable[prob_13_9_filtration X n]
      (prob_13_9_partialSum P X n) :=
    (prob_13_9_partialSum_adapted P X hX0 n).stronglyMeasurable
  have hSnCE :
      P[prob_13_9_partialSum P X n | prob_13_9_filtration X n] =
        prob_13_9_partialSum P X n :=
    condExp_of_stronglyMeasurable
      (chapter13_oneIndexedNaturalFiltration_sub_ambient X hXmeas_all n)
      hSn (prob_13_9_partialSum_integrable P X hXint_all n)
  rw [prob_13_9_partialSum_succ]
  have hadd := condExp_add
    (prob_13_9_partialSum_integrable P X hXint_all n)
    (prob_13_9_innovation_integrable P X hXint_all (n + 1))
    (prob_13_9_filtration X n)
  have hzero := prob_13_9_innovation_condExp_zero P X hXmeas_all hXint_all n
  filter_upwards [hadd, hzero] with ω haddω hzeroω
  rw [haddω]
  simp only [Pi.add_apply]
  rw [hSnCE, hzeroω]
  exact add_zero _
