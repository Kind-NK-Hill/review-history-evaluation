{"type":"item.completed","item":{"id":"item_33","type":"mcp_tool_call","server":"pilot","tool":"read_artifact","arguments":{"artifact_id":"c1:ProbabilityTheory/chapter_13/prob_13_9.lean"},"result":{"content":[{"type":"text","text":"{\"exit_code\": 0, \"stdout\": \"{\\\"action\\\": \\\"read_artifact\\\", \\\"result\\\": {\\\"artifact_id\\\": \\\"c1:ProbabilityTheory/chapter_13/prob_13_9.lean\\\", \\\"start_line\\\": 1, \\\"next_line\\\": null, \\\"total_lines\\\": 187, \\\"text\\\": \\\"/-\\\\nCopyright (c) 2026 ProbabilityTheoryFormalization contributors. All rights reserved.\\\\nReleased under Apache 2.0 license as described in the file LICENSE.\\\\nAuthors: ProbabilityTheoryFormalization contributors\\\\n-/\\\\nimport Mathlib\\\\nimport ProbabilityTheory.chapter_13.def_13_7\\\\nimport ProbabilityTheory.common_support.chapter13_stopping_support\\\\n\\\\n/-!\\\\n# Problem 13.9\\\\n\\\\nThe innovations of an integrable sequence, summed from time one, form a\\\\nmartingale with respect to the one-indexed natural filtration.\\\\n-/\\\\n\\\\nopen MeasureTheory\\\\nopen scoped BigOperators ProbabilityTheory\\\\nnoncomputable section\\\\n\\\\n/-- The natural filtration generated by `X\\\\u2081, ..., X\\\\u2099`, trivial at zero. -/\\\\nabbrev prob_13_9_filtration {\\\\u03a9 : Type*} (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d) :\\\\n    \\\\u2115 \\\\u2192 MeasurableSpace \\\\u03a9 := chapter13_oneIndexedNaturalFiltration X\\\\n\\\\n/-- The innovation is zero at time zero and `X\\\\u2099 - E[X\\\\u2099 | F\\\\u2099\\\\u208b\\\\u2081]` thereafter. -/\\\\ndef prob_13_9_innovation {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (P : Measure \\\\u03a9) (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d) : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d\\\\n  | 0 => 0\\\\n  | n + 1 => X (n + 1) - P[X (n + 1) | prob_13_9_filtration X n]\\\\n\\\\n/-- The partial sum `Y\\\\u2081 + ... + Y\\\\u2099`. -/\\\\ndef prob_13_9_partialSum {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (P : Measure \\\\u03a9) (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d) (n : \\\\u2115) : \\\\u03a9 \\\\u2192 \\\\u211d :=\\\\n  \\\\u2211 k \\\\u2208 Finset.range n, prob_13_9_innovation P X (k + 1)\\\\n\\\\n@[simp] theorem prob_13_9_innovation_zero {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (P : Measure \\\\u03a9) (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d) :\\\\n    prob_13_9_innovation P X 0 = 0 := rfl\\\\n\\\\n@[simp] theorem prob_13_9_innovation_succ {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (P : Measure \\\\u03a9) (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d) (n : \\\\u2115) :\\\\n    prob_13_9_innovation P X (n + 1) =\\\\n      X (n + 1) - P[X (n + 1) | prob_13_9_filtration X n] := rfl\\\\n\\\\n@[simp] theorem prob_13_9_partialSum_zero {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (P : Measure \\\\u03a9) (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d) : prob_13_9_partialSum P X 0 = 0 := by\\\\n  simp [prob_13_9_partialSum]\\\\n\\\\ntheorem prob_13_9_partialSum_succ {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (P : Measure \\\\u03a9) (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d) (n : \\\\u2115) :\\\\n    prob_13_9_partialSum P X (n + 1) =\\\\n      prob_13_9_partialSum P X n + prob_13_9_innovation P X (n + 1) := by\\\\n  unfold prob_13_9_partialSum\\\\n  rw [Finset.sum_range_succ]\\\\n\\\\ntheorem prob_13_9_observation_measurable {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d) (hX0 : X 0 = 0)\\\\n    (hXmeas : \\\\u2200 n : \\\\u2115, 1 \\\\u2264 n \\\\u2192 Measurable (X n)) :\\\\n    \\\\u2200 n : \\\\u2115, Measurable (X n) := by\\\\n  intro n\\\\n  cases n with\\\\n  | zero =>\\\\n      rw [hX0]\\\\n      fun_prop\\\\n  | succ n => exact hXmeas (n + 1) (Nat.succ_le_succ (Nat.zero_le n))\\\\n\\\\ntheorem prob_13_9_observation_adapted {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d) (hX0 : X 0 = 0) :\\\\n    def_13_6_adapted (prob_13_9_filtration X) X := by\\\\n  intro n\\\\n  cases n with\\\\n  | zero =>\\\\n      rw [hX0]\\\\n      fun_prop\\\\n  | succ n =>\\\\n      let k : Fin (n + 1) := \\\\u27e8n, Nat.lt_succ_self n\\\\u27e9\\\\n      have hh := chapter13_history_measurable_self X (n + 1)\\\\n      have hp := (measurable_pi_apply k).comp hh\\\\n      have heq : ((fun f : Fin (n + 1) \\\\u2192 \\\\u211d => f k) \\\\u2218\\\\n          chapter13_oneIndexedHistory X (n + 1)) = X (n + 1) := by\\\\n        funext \\\\u03c9\\\\n        simp [Function.comp_apply, chapter13_oneIndexedHistory, k]\\\\n      rw [heq] at hp\\\\n      exact hp\\\\n\\\\ntheorem prob_13_9_innovation_integrable {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (P : Measure \\\\u03a9) (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d)\\\\n    (hXint : \\\\u2200 n : \\\\u2115, 1 \\\\u2264 n \\\\u2192 Integrable (X n) P) :\\\\n    \\\\u2200 n : \\\\u2115, Integrable (prob_13_9_innovation P X n) P := by\\\\n  intro n\\\\n  cases n with\\\\n  | zero => simp\\\\n  | succ n =>\\\\n      exact (hXint (n + 1) (Nat.succ_le_succ (Nat.zero_le n))).sub integrable_condExp\\\\n\\\\ntheorem prob_13_9_innovation_adapted {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (P : Measure \\\\u03a9) (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d) (hX0 : X 0 = 0) :\\\\n    def_13_6_adapted (prob_13_9_filtration X) (prob_13_9_innovation P X) := by\\\\n  intro n\\\\n  cases n with\\\\n  | zero =>\\\\n      change @Measurable \\\\u03a9 \\\\u211d (prob_13_9_filtration X 0) _ (0 : \\\\u03a9 \\\\u2192 \\\\u211d)\\\\n      fun_prop\\\\n  | succ n =>\\\\n      apply Measurable.sub (prob_13_9_observation_adapted X hX0 (n + 1))\\\\n      have hc : @Measurable \\\\u03a9 \\\\u211d (prob_13_9_filtration X n) _\\\\n          P[X (n + 1) | prob_13_9_filtration X n] :=\\\\n        stronglyMeasurable_condExp.measurable\\\\n      exact hc.mono\\\\n        (chapter13_oneIndexedNaturalFiltration_mono X (Nat.le_succ n)) le_rfl\\\\n\\\\ntheorem prob_13_9_partialSum_integrable {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (P : Measure \\\\u03a9) (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d)\\\\n    (hXint : \\\\u2200 n : \\\\u2115, 1 \\\\u2264 n \\\\u2192 Integrable (X n) P) :\\\\n    \\\\u2200 n : \\\\u2115, Integrable (prob_13_9_partialSum P X n) P := by\\\\n  intro n\\\\n  exact integrable_finsetSum' _ fun k _ =>\\\\n    prob_13_9_innovation_integrable P X hXint (k + 1)\\\\n\\\\ntheorem prob_13_9_partialSum_adapted {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (P : Measure \\\\u03a9) (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d) (hX0 : X 0 = 0) :\\\\n    def_13_6_adapted (prob_13_9_filtration X) (prob_13_9_partialSum P X) := by\\\\n  intro n\\\\n  induction n with\\\\n  | zero =>\\\\n      rw [prob_13_9_partialSum_zero]\\\\n      fun_prop\\\\n  | succ n ih =>\\\\n      rw [prob_13_9_partialSum_succ]\\\\n      exact Measurable.add\\\\n        (ih.mono (chapter13_oneIndexedNaturalFiltration_mono X (Nat.le_succ n)) le_rfl)\\\\n        (prob_13_9_innovation_adapted P X hX0 (n + 1))\\\\n\\\\ntheorem prob_13_9_innovation_condExp_zero {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (P : Measure \\\\u03a9) [IsProbabilityMeasure P] (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d)\\\\n    (hX0 : X 0 = 0) (hXmeas : \\\\u2200 n : \\\\u2115, 1 \\\\u2264 n \\\\u2192 Measurable (X n))\\\\n    (hXint : \\\\u2200 n : \\\\u2115, 1 \\\\u2264 n \\\\u2192 Integrable (X n) P) (n : \\\\u2115) :\\\\n    P[prob_13_9_innovation P X (n + 1) | prob_13_9_filtration X n] =\\\\u1d50[P]\\\\n      (0 : \\\\u03a9 \\\\u2192 \\\\u211d) := by\\\\n  let F := prob_13_9_filtration X\\\\n  have hmeas_all := prob_13_9_observation_measurable X hX0 hXmeas\\\\n  have hFsub : F n \\\\u2264 \\\\u2039MeasurableSpace \\\\u03a9\\\\u203a :=\\\\n    chapter13_oneIndexedNaturalFiltration_sub_ambient X hmeas_all n\\\\n  have hXi : Integrable (X (n + 1)) P :=\\\\n    hXint (n + 1) (Nat.succ_le_succ (Nat.zero_le n))\\\\n  have hself : P[P[X (n + 1) | F n] | F n] = P[X (n + 1) | F n] :=\\\\n    condExp_of_stronglyMeasurable hFsub stronglyMeasurable_condExp integrable_condExp\\\\n  rw [prob_13_9_innovation_succ]\\\\n  calc\\\\n    P[X (n + 1) - P[X (n + 1) | F n] | F n]\\\\n        =\\\\u1d50[P] P[X (n + 1) | F n] - P[P[X (n + 1) | F n] | F n] :=\\\\n      condExp_sub hXi integrable_condExp _\\\\n    _ =\\\\u1d50[P] 0 := by simp [hself]\\\\n\\\\n/-- Problem 13.9: the concrete innovation sums are a martingale directly from\\\\nonly the source assumptions on the observations. -/\\\\ntheorem prob_13_9 {\\\\u03a9 : Type*} [MeasurableSpace \\\\u03a9]\\\\n    (P : Measure \\\\u03a9) [IsProbabilityMeasure P] (X : \\\\u2115 \\\\u2192 \\\\u03a9 \\\\u2192 \\\\u211d)\\\\n    (hX0 : X 0 = 0) (hXmeas : \\\\u2200 n : \\\\u2115, 1 \\\\u2264 n \\\\u2192 Measurable (X n))\\\\n    (hXint : \\\\u2200 n : \\\\u2115, 1 \\\\u2264 n \\\\u2192 Integrable (X n) P) :\\\\n    def_13_7 P (prob_13_9_filtration X) (prob_13_9_partialSum P X) := by\\\\n  have hmeas_all := prob_13_9_observation_measurable X hX0 hXmeas\\\\n  have hfiltration := chapter13_oneIndexedNaturalFiltration_isFiltration X hmeas_all\\\\n  have hSint := prob_13_9_partialSum_integrable P X hXint\\\\n  have hSadapt := prob_13_9_partialSum_adapted P X hX0\\\\n  refine \\\\u27e8hfiltration, hSint, hSadapt, ?_\\\\u27e9\\\\n  intro n\\\\n  have hFsub := chapter13_oneIndexedNaturalFiltration_sub_ambient X hmeas_all n\\\\n  refine \\\\u27e8inferInstance, hFsub, hSint (n + 1), ?_\\\\u27e9\\\\n  rw [prob_13_9_partialSum_succ]\\\\n  calc\\\\n    P[prob_13_9_partialSum P X n + prob_13_9_innovation P X (n + 1) |\\\\n        prob_13_9_filtration X n]\\\\n        =\\\\u1d50[P] P[prob_13_9_partialSum P X n | prob_13_9_filtration X n] +\\\\n          P[prob_13_9_innovation P X (n + 1) | prob_13_9_filtration X n] :=\\\\n      condExp_add (hSint n) (prob_13_9_innovation_integrable P X hXint (n + 1)) _\\\\n    _ =\\\\u1d50[P] prob_13_9_partialSum P X n + 0 := by\\\\n      filter_upwards [prob_13_9_innovation_condExp_zero P X hX0 hXmeas hXint n]\\\\n        with \\\\u03c9 hY\\\\n      rw [condExp_of_stronglyMeasurable hFsub\\\\n        (hSadapt n).stronglyMeasurable (hSint n)]\\\\n      change prob_13_9_partialSum P X n \\\\u03c9 +\\\\n        P[prob_13_9_innovation P X (n + 1) | prob_13_9_filtration X n] \\\\u03c9 =\\\\n        prob_13_9_partialSum P X n \\\\u03c9 + 0\\\\n      rw [hY]\\\\n      simp\\\\n    _ =\\\\u1d50[P] prob_13_9_partialSum P X n := by simp\\\"}, \\\"deadline\\\": {\\\"allowance_seconds\\\": 5400.0, \\\"started_epoch\\\": 1789097537.5854557, \\\"deadline_epoch\\\": 1789102937.5854557, \\\"remaining_seconds\\\": 4897.969489097595}}\\r\\n\", \"stderr\": \"\", \"stdout_sha256\": \"0ec74b5cf3d82e585ea8f6d7a3114d6f2962a3236902110c6847f90e8d6436b4\", \"stdout_bytes\": 9309, \"stdout_truncated\": false, \"stderr_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\", \"stderr_bytes\": 0, \"stderr_truncated\": false, \"backend_error\": null}"}],"structured_content":null},"error":null,"status":"completed"}}
