import Mathlib
import ProbabilityTheory.chapter_13.def_13_7
import ProbabilityTheory.common_support.chapter13_stopping_support

/-!
# Problem 13.9

The innovations of an integrable sequence, summed from time one, form a
martingale with respect to the one-indexed natural filtration.
-/

open MeasureTheory
open scoped BigOperators ProbabilityTheory
noncomputable section

/-- The natural filtration generated by `X₁, ..., Xₙ`, trivial at zero. -/
abbrev prob_13_9_filtration {Ω : Type*} (X : ℕ → Ω → ℝ) :
    ℕ → MeasurableSpace Ω := chapter13_oneIndexedNaturalFiltration X

/-- The innovation is zero at time zero and `Xₙ - E[Xₙ | Fₙ₋₁]` thereafter. -/
def prob_13_9_innovation {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) : ℕ → Ω → ℝ
  | 0 => 0
  | n + 1 => X (n + 1) - P[X (n + 1) | prob_13_9_filtration X n]

/-- The partial sum `Y₁ + ... + Yₙ`. -/
def prob_13_9_partialSum {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) (n : ℕ) : Ω → ℝ :=
  ∑ k ∈ Finset.range n, prob_13_9_innovation P X (k + 1)

@[simp] theorem prob_13_9_innovation_zero {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) :
    prob_13_9_innovation P X 0 = 0 := rfl

@[simp] theorem prob_13_9_innovation_succ {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) (n : ℕ) :
    prob_13_9_innovation P X (n + 1) =
      X (n + 1) - P[X (n + 1) | prob_13_9_filtration X n] := rfl

@[simp] theorem prob_13_9_partialSum_zero {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) : prob_13_9_partialSum P X 0 = 0 := by
  simp [prob_13_9_partialSum]

theorem prob_13_9_partialSum_succ {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) (n : ℕ) :
    prob_13_9_partialSum P X (n + 1) =
      prob_13_9_partialSum P X n + prob_13_9_innovation P X (n + 1) := by
  unfold prob_13_9_partialSum
  rw [Finset.sum_range_succ]

theorem prob_13_9_observation_measurable {Ω : Type*} [MeasurableSpace Ω]
    (X : ℕ → Ω → ℝ) (hX0 : X 0 = 0)
    (hXmeas : ∀ n : ℕ, 1 ≤ n → Measurable (X n)) :
    ∀ n : ℕ, Measurable (X n) := by
  intro n
  cases n with
  | zero =>
      rw [hX0]
      fun_prop
  | succ n => exact hXmeas (n + 1) (Nat.succ_le_succ (Nat.zero_le n))

theorem prob_13_9_observation_adapted {Ω : Type*} [MeasurableSpace Ω]
    (X : ℕ → Ω → ℝ) (hX0 : X 0 = 0) :
    def_13_6_adapted (prob_13_9_filtration X) X := by
  intro n
  cases n with
  | zero =>
      rw [hX0]
      fun_prop
  | succ n =>
      let k : Fin (n + 1) := ⟨n, Nat.lt_succ_self n⟩
      have hh := chapter13_history_measurable_self X (n + 1)
      have hp := (measurable_pi_apply k).comp hh
      have heq : ((fun f : Fin (n + 1) → ℝ => f k) ∘
          chapter13_oneIndexedHistory X (n + 1)) = X (n + 1) := by
        funext ω
        simp [Function.comp_apply, chapter13_oneIndexedHistory, k]
      rw [heq] at hp
      exact hp

theorem prob_13_9_innovation_integrable {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ)
    (hXint : ∀ n : ℕ, 1 ≤ n → Integrable (X n) P) :
    ∀ n : ℕ, Integrable (prob_13_9_innovation P X n) P := by
  intro n
  cases n with
  | zero => simp
  | succ n =>
      exact (hXint (n + 1) (Nat.succ_le_succ (Nat.zero_le n))).sub integrable_condExp

theorem prob_13_9_innovation_adapted {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) (hX0 : X 0 = 0) :
    def_13_6_adapted (prob_13_9_filtration X) (prob_13_9_innovation P X) := by
  intro n
  cases n with
  | zero =>
      change @Measurable Ω ℝ (prob_13_9_filtration X 0) _ (0 : Ω → ℝ)
      fun_prop
  | succ n =>
      apply Measurable.sub (prob_13_9_observation_adapted X hX0 (n + 1))
      have hc : @Measurable Ω ℝ (prob_13_9_filtration X n) _
          P[X (n + 1) | prob_13_9_filtration X n] :=
        stronglyMeasurable_condExp.measurable
      exact hc.mono
        (chapter13_oneIndexedNaturalFiltration_mono X (Nat.le_succ n)) le_rfl

theorem prob_13_9_partialSum_integrable {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ)
    (hXint : ∀ n : ℕ, 1 ≤ n → Integrable (X n) P) :
    ∀ n : ℕ, Integrable (prob_13_9_partialSum P X n) P := by
  intro n
  exact integrable_finsetSum' _ fun k _ =>
    prob_13_9_innovation_integrable P X hXint (k + 1)

theorem prob_13_9_partialSum_adapted {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : ℕ → Ω → ℝ) (hX0 : X 0 = 0) :
    def_13_6_adapted (prob_13_9_filtration X) (prob_13_9_partialSum P X) := by
  intro n
  induction n with
  | zero =>
      rw [prob_13_9_partialSum_zero]
      fun_prop
  | succ n ih =>
      rw [prob_13_9_partialSum_succ]
      exact Measurable.add
        (ih.mono (chapter13_oneIndexedNaturalFiltration_mono X (Nat.le_succ n)) le_rfl)
        (prob_13_9_innovation_adapted P X hX0 (n + 1))

theorem prob_13_9_innovation_condExp_zero {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (X : ℕ → Ω → ℝ)
    (hX0 : X 0 = 0) (hXmeas : ∀ n : ℕ, 1 ≤ n → Measurable (X n))
    (hXint : ∀ n : ℕ, 1 ≤ n → Integrable (X n) P) (n : ℕ) :
    P[prob_13_9_innovation P X (n + 1) | prob_13_9_filtration X n] =ᵐ[P]
      (0 : Ω → ℝ) := by
  let F := prob_13_9_filtration X
  have hmeas_all := prob_13_9_observation_measurable X hX0 hXmeas
  have hFsub : F n ≤ ‹MeasurableSpace Ω› :=
    chapter13_oneIndexedNaturalFiltration_sub_ambient X hmeas_all n
  have hXi : Integrable (X (n + 1)) P :=
    hXint (n + 1) (Nat.succ_le_succ (Nat.zero_le n))
  have hself : P[P[X (n + 1) | F n] | F n] = P[X (n + 1) | F n] :=
    condExp_of_stronglyMeasurable hFsub stronglyMeasurable_condExp integrable_condExp
  rw [prob_13_9_innovation_succ]
  calc
    P[X (n + 1) - P[X (n + 1) | F n] | F n]
        =ᵐ[P] P[X (n + 1) | F n] - P[P[X (n + 1) | F n] | F n] :=
      condExp_sub hXi integrable_condExp _
    _ =ᵐ[P] 0 := by simp [hself]

/-- Problem 13.9: the concrete innovation sums are a martingale directly from
only the source assumptions on the observations. -/
theorem prob_13_9 {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (X : ℕ → Ω → ℝ)
    (hX0 : X 0 = 0) (hXmeas : ∀ n : ℕ, 1 ≤ n → Measurable (X n))
    (hXint : ∀ n : ℕ, 1 ≤ n → Integrable (X n) P) :
    def_13_7 P (prob_13_9_filtration X) (prob_13_9_partialSum P X) := by
  have hmeas_all := prob_13_9_observation_measurable X hX0 hXmeas
  have hfiltration := chapter13_oneIndexedNaturalFiltration_isFiltration X hmeas_all
  have hSint := prob_13_9_partialSum_integrable P X hXint
  have hSadapt := prob_13_9_partialSum_adapted P X hX0
  refine ⟨hfiltration, hSint, hSadapt, ?_⟩
  intro n
  have hFsub := chapter13_oneIndexedNaturalFiltration_sub_ambient X hmeas_all n
  refine ⟨inferInstance, hFsub, hSint (n + 1), ?_⟩
  rw [prob_13_9_partialSum_succ]
  calc
    P[prob_13_9_partialSum P X n + prob_13_9_innovation P X (n + 1) |
        prob_13_9_filtration X n]
        =ᵐ[P] P[prob_13_9_partialSum P X n | prob_13_9_filtration X n] +
          P[prob_13_9_innovation P X (n + 1) | prob_13_9_filtration X n] :=
      condExp_add (hSint n) (prob_13_9_innovation_integrable P X hXint (n + 1)) _
    _ =ᵐ[P] prob_13_9_partialSum P X n + 0 := by
      filter_upwards [prob_13_9_innovation_condExp_zero P X hX0 hXmeas hXint n]
        with ω hY
      rw [condExp_of_stronglyMeasurable hFsub
        (hSadapt n).stronglyMeasurable (hSint n)]
      change prob_13_9_partialSum P X n ω +
        P[prob_13_9_innovation P X (n + 1) | prob_13_9_filtration X n] ω =
        prob_13_9_partialSum P X n ω + 0
      rw [hY]
      simp
    _ =ᵐ[P] prob_13_9_partialSum P X n := by simp
