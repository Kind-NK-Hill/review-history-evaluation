")))\\r\\n\\r\\n\\r\\ndef _matches_version(value: Any, expected: int) -> bool:\\r\\n    if isinstance(value, bool):\\r\\n        return False\\r\\n    try:\\r\\n        return int(value) == expected\\r\\n\\r\\ndef copy_file(source: Path, target: Path) -> None:\\r\\n    shutil.copyfile(fs_path(source), fs_path(target))\\r\\n\\r\\n\\r\\ndef sha256_text(text: str) -> str:\\r\\n    return hashlib.sha256(text.encode(\\\"utf-8\\\")).hexdigest()\\r\\n\\r\\n\\r\\ndef sha256_json(payload: Any) -> str:\\r\\n    return sha256_text(json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(\\\",\\\", \\\":\\\")))\\r\\n\", \"stderr\": \"\", \"stdout_truncated\": false, \"stderr_truncated\": false, \"raw_stdout\": {\"bytes\": 1745, \"sha256\": \"3bf044ae3c08d945a8069a903b18b2976b1d22c147d522285722e84ff6bacef2\"}, \"raw_stderr\": {\"bytes\": 0, \"sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"}}"}],"structured_content":null},"error":null,"status":"completed"}}
